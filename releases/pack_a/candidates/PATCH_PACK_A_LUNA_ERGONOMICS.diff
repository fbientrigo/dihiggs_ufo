+#!/usr/bin/env bash
+# preflight checks. Sourced only; defines pack_a_cmd_preflight.
+
+# Expected hashes of the eight physics-invariant files, fixed by the
+# immutable PI original (pi_ufo_baseline_v1.zip, sha256
+# 632bf77818c84118fa707ad058cb655b90d018a394290cf565ab9d50f2db08cd) and
+# reproduced unchanged through every downstream candidate. These are a
+# documented invariant, not something this script derives at runtime.
+declare -A PACK_A_PHYSICS_FILE_SHA256=(
+  [couplings.py]=199021f332fa57314f1a9dbd487a08c8310f9d5b4ce408eaa6c5ea99a649c3f4
+  [vertices.py]=60bb131379499fd85ac21da8e15f960cffcf2d33afc54217481730e82648f6ba
+  [particles.py]=01c61a7a352a5bebb747fff0c9ac3e228fa7575dfc381a339ecb285332b223c6
+  [parameters.py]=7f84d779ff83dd52bbfecbbfe31df147e2df79faab0bcda716d5908d63b3d45b
+  [decays.py]=ebb92183abff92cdaf55aeb80399effe2cc0256f1423ce807a390cd420564e23
+  [form_factors.py]=9fdae69a684ddd1eb5963a1695e0f5449045755826aa62a8829569848b32f478
+  [lorentz.py]=4b818a0fd7a9f1ded91a957251380f4116a30454f8e1fc72e1c7ccacdab6bf8f
+  [coupling_orders.py]=80d652d3441c1fed3242dc7a4141a12f5a7ccc2f2cc6764dd5d22bb39083d132
+)
+
+_pf_rows=()
+_pf_status=0   # operational blocker seen
+_pf_row() {
+  # _pf_row STATUS NAME DETAIL
+  _pf_rows+=("$1|$2|$3")
+  [[ "$1" == "FAIL" ]] && _pf_status=1
+  return 0
+}
+
+pack_a_cmd_preflight() {
+  _pf_rows=()
+  _pf_status=0
+  cd "$PACK_ROOT" || pack_a_die "cannot cd to pack root $PACK_ROOT"
+
+  # 1. Python resolution (done first: later checks need it)
+  local py="" py_diag
+  if py_diag="$(pack_a_resolve_python 2>&1 1>/tmp/pack_a_preflight_py.$$)"; then
+    py="$(cat /tmp/pack_a_preflight_py.$$)"
+    _pf_row PASS "python" "$py_diag"
+  else
+    _pf_row FAIL "python" "$py_diag"
+  fi
+  rm -f /tmp/pack_a_preflight_py.$$
+
+  # 2. PyYAML importable via resolved python (only if python resolved)
+  if [[ -n "$py" ]]; then
+    if "$py" -c 'import yaml' >/dev/null 2>&1; then
+      _pf_row PASS "PyYAML" "importable via $py"
+    else
+      _pf_row FAIL "PyYAML" "not importable via $py"
+    fi
+  fi
+
+  # 3. Pack integrity via checksums.sha256
+  if [[ -f checksums.sha256 ]]; then
+    if sha256sum -c checksums.sha256 >/tmp/pack_a_preflight_checksums.$$ 2>&1; then
+      _pf_row PASS "pack integrity" "sha256sum -c checksums.sha256: all OK"
+    else
+      _pf_row FAIL "pack integrity" "sha256sum -c checksums.sha256 reported mismatches (see below)"
+    fi
+    rm -f /tmp/pack_a_preflight_checksums.$$
+  else
+    _pf_row FAIL "pack integrity" "checksums.sha256 not found at pack root"
+  fi
+
+  # 4. manifest.json valid JSON
+  if [[ -f manifest.json ]]; then
+    if [[ -n "$py" ]] && "$py" -c 'import json,sys; json.load(open("manifest.json"))' 2>/tmp/pack_a_preflight_json.$$; then
+      _pf_row PASS "manifest.json" "valid JSON"
+    elif [[ -z "$py" ]]; then
+      _pf_row WARN "manifest.json" "present but not validated (no Python resolved)"
+    else
+      _pf_row FAIL "manifest.json" "invalid JSON: $(tail -1 /tmp/pack_a_preflight_json.$$)"
+    fi
+    rm -f /tmp/pack_a_preflight_json.$$
+  else
+    _pf_row FAIL "manifest.json" "not found at pack root"
+  fi
+
+  # 5. Eight physics-invariant files byte-identical to the PI original
+  local physfail=0
+  local f expect got
+  for f in "${!PACK_A_PHYSICS_FILE_SHA256[@]}"; do
+    expect="${PACK_A_PHYSICS_FILE_SHA256[$f]}"
+    local path="model/LLscalar_v3_UFO_runtime/$f"
+    if [[ ! -f "$path" ]]; then
+      _pf_row FAIL "physics file $f" "missing at $path"
+      physfail=1
+      continue
+    fi
+    got="$(sha256sum "$path" | awk '{print $1}' || true)"
+    if [[ "$got" != "$expect" ]]; then
+      _pf_row FAIL "physics file $f" "hash mismatch: expected $expect got $got"
+      physfail=1
+    fi
+  done
+  [[ $physfail -eq 0 ]] && _pf_row PASS "physics files (8/8)" "byte-identical to PI original"
+
+  # 6. Physics overrides must not be present anywhere in the invocation env
+  local override
+  local forbidden_overrides=(PACK_A_FORCE_MASS PACK_A_FORCE_COUPLING PACK_A_FORCE_PROCESS PACK_A_FORCE_DECAY)
+  local override_seen=0
+  for override in "${forbidden_overrides[@]}"; do
+    if [[ -n "${!override:-}" ]]; then
+      _pf_row FAIL "physics override guard" "$override is set in environment; not permitted"
+      override_seen=1
+    fi
+  done
+  [[ $override_seen -eq 0 ]] && _pf_row PASS "physics override guard" "no forbidden override variables set"
+
+  # 7. MadGraph resolution
+  local mg5_diag mg5_bin
+  if mg5_diag="$(pack_a_resolve_mg5 2>&1 1>/dev/null)"; then
+    mg5_bin="$(pack_a_resolve_mg5 2>/dev/null || true)"
+    _pf_row PASS "madgraph" "$mg5_diag"
+    local banner
+    banner="$(pack_a_mg5_version_banner "$mg5_bin" 2>&1 || true)"
+    if grep -q 'VERSION 3.5.3' <<<"$banner"; then
+      _pf_row PASS "madgraph version" "confirmed VERSION 3.5.3 from startup banner"
+    else
+      _pf_row WARN "madgraph version" "could not confirm VERSION 3.5.3 from startup banner (toolchain may differ from the validated 3.5.3)"
+    fi
+    if grep -qi 'unknown development version' <<<"$banner"; then
+      _pf_row WARN "madgraph build" "this MG5 3.5.3 install self-identifies as an unknown development build (known Sol warning, not a blocker)"
+    fi
+  else
+    _pf_row FAIL "madgraph" "$mg5_diag"
+  fi
+
+  # 8. Required operational scripts present
+  local script
+  local required_scripts=(scripts/build_point.py scripts/run_mg5_smoke.sh scripts/patch_mg5_run_card.py scripts/inspect_lhe.py scripts/extract_mg5_cross_section.py scripts/model_utils.py)
+  local scriptfail=0
+  for script in "${required_scripts[@]}"; do
+    [[ -f "$script" ]] || { _pf_row FAIL "required script" "$script missing"; scriptfail=1; }
+  done
+  [[ $scriptfail -eq 0 ]] && _pf_row PASS "required scripts" "all present"
+
+  # 9. Writable runs area
+  if mkdir -p "$PACK_ROOT/runs" 2>/dev/null && [[ -w "$PACK_ROOT/runs" ]]; then
+    _pf_row PASS "runs/ writable" "$PACK_ROOT/runs"
+  else
+    _pf_row FAIL "runs/ writable" "$PACK_ROOT/runs is not writable"
+  fi
+
+  # 10. Known scientific status (informative only, never a blocker)
+  _pf_row INFO "scientific status" "PASS_WITH_WARNINGS (Sol validation); classification PACK_A_LO_SMOKE_XSEC; not publishable production normalization"
+
+  # 11. MadeEvent sequence sanity (informative)
+  if grep -q "printf '0\\\\nupdate dependent\\\\n0\\\\n'" scripts/run_mg5_smoke.sh 2>/dev/null; then
+    _pf_row PASS "MadeEvent sequence" "0 / update dependent / 0 (Sol-corrected, no rejected commands)"
+  else
+    _pf_row WARN "MadeEvent sequence" "expected '0 / update dependent / 0' pattern not found verbatim in scripts/run_mg5_smoke.sh; inspect before trusting run output"
+  fi
+
+  # 12. Pythia/FastJet - informative and optional only
+  if command -v pythia8-config >/dev/null 2>&1 || [[ -n "${PYTHIA8_CONFIG:-}" ]]; then
+    _pf_row INFO "Pythia" "detected (informative only; not used by Pack A native, not run by this interface)"
+  else
+    _pf_row INFO "Pythia" "not detected (informative only; not required by Pack A native)"
+  fi
+  if command -v fastjet-config >/dev/null 2>&1; then
+    _pf_row INFO "FastJet" "detected (informative only; not used by Pack A native)"
+  else
+    _pf_row INFO "FastJet" "not detected (informative only; not required by Pack A native)"
+  fi
+
+  # Print table
+  echo
+  printf '%-26s %-6s %s\n' "CHECK" "STATE" "DETAIL"
+  printf '%-26s %-6s %s\n' "-----" "-----" "------"
+  local row state name detail
+  for row in "${_pf_rows[@]}"; do
+    IFS='|' read -r state name detail <<<"$row"
+    printf '%-26s %-6s %s\n' "$name" "$state" "$detail"
+  done
+  echo
+
+  if [[ $_pf_status -eq 0 ]]; then
+    pack_a_log "PREFLIGHT: usable (0 operational blockers; warnings above, if any, are known scientific caveats)"
+    return 0
+  else
+    pack_a_log "PREFLIGHT: BLOCKED (see FAIL rows above)"
+    return 21
+  fi
+}
