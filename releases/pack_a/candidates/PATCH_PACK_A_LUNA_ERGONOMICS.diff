+#!/usr/bin/env bash
+# Shared helpers for bin/pack-a. Sourced only, never executed directly.
+
+pack_a_log() {
+  printf '[%s] %s\n' "$(date -u +%FT%TZ)" "$*"
+}
+
+pack_a_ts() {
+  date -u +%Y%m%dT%H%M%SZ
+}
+
+pack_a_die() {
+  echo "BLOCKED: $*" >&2
+  exit 20
+}
+
+# json_escape STRING - minimal JSON string escaping for hand-written JSON.
+pack_a_json_escape() {
+  local s="$1"
+  s="${s//\\/\\\\}"
+  s="${s//\"/\\\"}"
+  s="${s//$'\n'/\\n}"
+  printf '%s' "$s"
+}
