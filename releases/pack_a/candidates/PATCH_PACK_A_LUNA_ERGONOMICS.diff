+#!/usr/bin/env bash
+# `status`: report on the most recent run without reinterpreting physics.
+# Sourced only.
+
+pack_a_find_last_run() {
+  local runs_dir="$PACK_ROOT/runs"
+  if [[ -f "$runs_dir/.last_run" ]]; then
+    cat "$runs_dir/.last_run"
+    return 0
+  fi
+  find "$runs_dir" -maxdepth 1 -mindepth 1 -type d -name '2*_seed*' 2>/dev/null | sort | tail -1
+}
+
+pack_a_cmd_status() {
+  local run_dir
+  run_dir="$(pack_a_find_last_run)"
+  if [[ -z "$run_dir" || ! -d "$run_dir" ]]; then
+    echo "No Pack A runs found under $PACK_ROOT/runs. Run '$0 run' first."
+    return 0
+  fi
+
+  local exit_status="(unknown - run may still be in progress or crashed before finalize)"
+  [[ -f "$run_dir/exit_status.txt" ]] && exit_status="$(cat "$run_dir/exit_status.txt")"
+
+  echo "Last run:        $run_dir"
+  echo "Exit status:     $exit_status"
+  [[ -f "$run_dir/command.txt" ]] && { echo "Command info:"; sed 's/^/  /' "$run_dir/command.txt"; }
+
+  if [[ -n "${PACK_A_PYTHON:-}" && -f "$run_dir/validation/cross_section.json" ]]; then
+    "$PACK_A_PYTHON" -c "
+import json
+d = json.load(open('$run_dir/validation/cross_section.json'))
+print('sigma_pb:        ', d.get('sigma_pb'))
+print('integration_err: ', d.get('integration_error_pb'))
+" || true
+  fi
+  if [[ -n "${PACK_A_PYTHON:-}" && -f "$run_dir/validation/lhe_report.json" ]]; then
+    "$PACK_A_PYTHON" -c "
+import json
+d = json.load(open('$run_dir/validation/lhe_report.json'))
+print('events:          ', d.get('events'))
+print('llp_stable:      ', d.get('llp_stable_in_lhe'))
+print('nonfinal_llp:    ', d.get('nonfinal_llp_records'))
+" || true
+  fi
+  local lhe
+  lhe="$(find "$run_dir/events" -maxdepth 1 -type f \( -name '*.lhe.gz' -o -name '*.lhe' \) 2>/dev/null | head -1)"
+  [[ -n "$lhe" ]] && echo "LHE path:         $lhe"
+  echo "Log path:         $run_dir/run.log"
+
+  if [[ -f "$run_dir/exit_status.txt" && "$(cat "$run_dir/exit_status.txt")" == "0" ]]; then
+    echo "Validation state: PASS_WITH_WARNINGS (classification PACK_A_LO_SMOKE_XSEC; see docs/PACK_A_SCIENTIFIC_SCOPE.md)"
+  else
+    echo "Validation state: NOT PASSING (see log above)"
+  fi
+  return 0
+}
