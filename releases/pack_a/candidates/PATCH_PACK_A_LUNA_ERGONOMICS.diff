+#!/usr/bin/env python3
+"""Luna operational check: verifies a generated LHE against the Pack A
+scientific invariants fixed by Sol's validation (see
+PACK_A_SOL_SCIENTIFIC_VALIDATION.md at the workspace root). This is a
+read-only analysis tool; it never edits the UFO, the LHE, or any card.
+
+Checked invariants (all from the Sol report, not re-derived here):
+  - exactly two final-state (status 1) PDG 9000006 records per event
+  - zero non-final PDG 9000006 records
+  - h2 mass exactly 200 GeV in the particle record
+  - mothers of each h2 are (1, 2)
+  - four-momentum conserved per event within 1e-6 GeV
+"""
+from __future__ import annotations
+
+import argparse
+import gzip
+import json
+import math
+from pathlib import Path
+
+LLP_PDG = 9000006
+MASS_TOLERANCE_GEV = 1e-3
+MOMENTUM_TOLERANCE_GEV = 1e-6
+
+
+def opener(path: Path):
+    return gzip.open(path, "rt", encoding="utf-8", errors="replace") if path.suffix == ".gz" else path.open("rt", encoding="utf-8", errors="replace")
+
+
+def parse_events(path: Path):
+    events = []
+    current = None
+    with opener(path) as fh:
+        for line in fh:
+            s = line.strip()
+            if s == "<event>":
+                current = []
+                continue
+            if s == "</event>":
+                events.append(current or [])
+                current = None
+                continue
+            if current is None or not s or s.startswith("#"):
+                continue
+            fields = s.split()
+            if len(fields) < 11:
+                continue
+            try:
+                pid = int(fields[0])
+                status = int(fields[1])
+                mother1 = int(fields[2])
+                mother2 = int(fields[3])
+                px, py, pz, e, m = (float(x) for x in fields[6:11])
+            except ValueError:
+                continue
+            current.append({
+                "pid": pid, "status": status, "mothers": (mother1, mother2),
+                "p": (px, py, pz, e), "mass": m,
+            })
+    return events
+
+
+def check(lhe_path: Path, expected_mass_gev: float) -> dict:
+    events = parse_events(lhe_path)
+    n_events = len(events)
+    total_llp_final = 0
+    total_llp_nonfinal = 0
+    mother_mismatches = []
+    mass_mismatches = []
+    worst_residual = 0.0
+    residuals = []
+
+    for idx, ev in enumerate(events):
+        tot = [0.0, 0.0, 0.0, 0.0]
+        llp_final_this_event = []
+        for rec in ev:
+            sign = 0
+            if rec["status"] == -1:
+                sign = -1
+            elif rec["status"] == 1:
+                sign = 1
+            if sign:
+                for k in range(4):
+                    tot[k] += sign * rec["p"][k]
+            if abs(rec["pid"]) == LLP_PDG:
+                if rec["status"] == 1:
+                    total_llp_final += 1
+                    llp_final_this_event.append(rec)
+                    if rec["mothers"] != (1, 2):
+                        mother_mismatches.append({"event": idx, "mothers": rec["mothers"]})
+                    if abs(rec["mass"] - expected_mass_gev) > MASS_TOLERANCE_GEV:
+                        mass_mismatches.append({"event": idx, "mass": rec["mass"]})
+                else:
+                    total_llp_nonfinal += 1
+        residual = max(abs(x) for x in tot)
+        residuals.append(residual)
+        worst_residual = max(worst_residual, residual)
+
+    report = {
+        "events": n_events,
+        "llp_pdg": LLP_PDG,
+        "total_llp_final_records": total_llp_final,
+        "expected_llp_final_records": n_events * 2,
+        "total_llp_nonfinal_records": total_llp_nonfinal,
+        "mother_mismatches": mother_mismatches,
+        "mass_mismatches": mass_mismatches,
+        "expected_h2_mass_gev": expected_mass_gev,
+        "worst_four_momentum_residual_gev": worst_residual,
+        "momentum_tolerance_gev": MOMENTUM_TOLERANCE_GEV,
+    }
+    passed = (
+        n_events > 0
+        and total_llp_final == n_events * 2
+        and total_llp_nonfinal == 0
+        and not mother_mismatches
+        and not mass_mismatches
+        and worst_residual <= MOMENTUM_TOLERANCE_GEV
+    )
+    report["pass"] = passed
+    return report
+
+
+def compare_cross_section(sigma_pb: float, error_pb: float, ref_sigma_pb: float, ref_error_pb: float) -> dict:
+    delta = abs(sigma_pb - ref_sigma_pb)
+    combined = math.sqrt(error_pb ** 2 + ref_error_pb ** 2)
+    limit = 3 * combined
+    return {
+        "sigma_pb": sigma_pb,
+        "integration_error_pb": error_pb,
+        "reference_sigma_pb": ref_sigma_pb,
+        "reference_integration_error_pb": ref_error_pb,
+        "delta_pb": delta,
+        "combined_1sigma_pb": combined,
+        "three_sigma_limit_pb": limit,
+        "pull": delta / combined if combined else None,
+        "compatible_at_3sigma": delta <= limit,
+    }
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--lhe", required=True, type=Path)
+    ap.add_argument("--expected-mass-gev", type=float, default=200.0)
+    ap.add_argument("--sigma-pb", type=float)
+    ap.add_argument("--sigma-error-pb", type=float)
+    ap.add_argument("--ref-sigma-pb", type=float)
+    ap.add_argument("--ref-sigma-error-pb", type=float)
+    ap.add_argument("--output", type=Path)
+    args = ap.parse_args()
+
+    report = check(args.lhe, args.expected_mass_gev)
+    if args.sigma_pb is not None and args.ref_sigma_pb is not None:
+        report["cross_section_comparison"] = compare_cross_section(
+            args.sigma_pb, args.sigma_error_pb or 0.0, args.ref_sigma_pb, args.ref_sigma_error_pb or 0.0
+        )
+        report["pass"] = report["pass"] and report["cross_section_comparison"]["compatible_at_3sigma"]
+
+    text = json.dumps(report, indent=2, sort_keys=True) + "\n"
+    if args.output:
+        args.output.write_text(text, encoding="utf-8")
+    print(text, end="")
+    return 0 if report["pass"] else 3
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
