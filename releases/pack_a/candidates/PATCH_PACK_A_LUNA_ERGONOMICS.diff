+#!/usr/bin/env bash
+# Pack A native operator interface (Luna release-candidate ergonomics layer).
+#
+# Usage: pack-a <preflight|run|reproduce|status|results|clean> [options]
+#
+# This is a normal executable script - run it, do not `source` it. It never
+# modifies your interactive shell, never changes your working directory, and
+# always returns its real exit status even when a stage fails.
+set -Eeuo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+PACK_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
+
+# shellcheck source=lib/common.sh
+source "$SCRIPT_DIR/lib/common.sh"
+# shellcheck source=lib/resolve.sh
+source "$SCRIPT_DIR/lib/resolve.sh"
+# shellcheck source=lib/preflight.sh
+source "$SCRIPT_DIR/lib/preflight.sh"
+# shellcheck source=lib/run.sh
+source "$SCRIPT_DIR/lib/run.sh"
+# shellcheck source=lib/reproduce.sh
+source "$SCRIPT_DIR/lib/reproduce.sh"
+# shellcheck source=lib/status.sh
+source "$SCRIPT_DIR/lib/status.sh"
+# shellcheck source=lib/results.sh
+source "$SCRIPT_DIR/lib/results.sh"
+# shellcheck source=lib/clean.sh
+source "$SCRIPT_DIR/lib/clean.sh"
+
+usage() {
+  cat <<EOF
+Usage: $0 <command> [options]
+
+Commands:
+  preflight              verify pack integrity, toolchain, and physics invariants
+  run [--label L] [--output-root DIR] [--seed 12345|67890]
+                         run the canonical Pack A native generation
+  reproduce [--seed 12345|67890]
+                         clean extraction + preflight + run + invariant check
+  status                 report on the most recent run
+  results                locate and summarize evidence for the most recent run
+  clean --confirm        remove interface-generated run directories only
+
+See docs/PACK_A_QUICKSTART.md and docs/PACK_A_OPERATOR_COMMANDS.md (workspace
+root) for copy-pasteable examples.
+EOF
+}
+
+main() {
+  local cmd="${1:-}"
+  [[ $# -gt 0 ]] && shift || true
+  case "$cmd" in
+    preflight) pack_a_cmd_preflight "$@" ;;
+    run) pack_a_cmd_run "$@" ;;
+    reproduce) pack_a_cmd_reproduce "$@" ;;
+    status)
+      PACK_A_PYTHON="$(pack_a_resolve_python 2>/dev/null || true)"
+      export PACK_A_PYTHON
+      pack_a_cmd_status "$@"
+      ;;
+    results)
+      PACK_A_PYTHON="$(pack_a_resolve_python 2>/dev/null || true)"
+      export PACK_A_PYTHON
+      pack_a_cmd_results "$@"
+      ;;
+    clean) pack_a_cmd_clean "$@" ;;
+    -h|--help|help|"") usage; [[ "$cmd" == "" ]] && exit 2 || exit 0 ;;
+    *)
+      echo "BLOCKED: unknown command '$cmd'" >&2
+      usage >&2
+      exit 2
+      ;;
+  esac
+}
+
+main "$@"
