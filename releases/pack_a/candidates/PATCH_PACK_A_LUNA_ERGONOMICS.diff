+#!/usr/bin/env bash
+# `clean --confirm`: conservative removal of interface-generated workdirs
+# only. Never touches ZIPs, docs, manifests, or promoted evidence. Sourced only.
+
+pack_a_cmd_clean() {
+  local confirmed=0
+  while [[ $# -gt 0 ]]; do
+    case "$1" in
+      --confirm) confirmed=1; shift ;;
+      *) pack_a_die "unrecognized option '$1' for 'clean'" ;;
+    esac
+  done
+
+  local runs_dir="$PACK_ROOT/runs"
+  if [[ ! -d "$runs_dir" ]]; then
+    echo "Nothing to clean: $runs_dir does not exist."
+    return 0
+  fi
+
+  # Only ever consider directories directly under runs/ whose names match
+  # this interface's own naming scheme (timestamp-prefixed). Never resolve
+  # through symlinks, never touch runs_dir itself if it is empty or a
+  # symlink, never touch anything outside runs_dir.
+  if [[ -L "$runs_dir" ]]; then
+    pack_a_die "refusing to clean: $runs_dir is a symlink"
+  fi
+
+  local -a targets=()
+  local entry base
+  while IFS= read -r -d '' entry; do
+    [[ -L "$entry" ]] && continue
+    base="$(basename "$entry")"
+    [[ "$base" =~ ^[0-9]{8}T[0-9]{6}Z_ ]] || continue
+    targets+=("$entry")
+  done < <(find "$runs_dir" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null)
+
+  if [[ ${#targets[@]} -eq 0 ]]; then
+    echo "Nothing to clean: no interface-generated run directories found under $runs_dir."
+    return 0
+  fi
+
+  echo "The following run directories would be removed:"
+  local t
+  for t in "${targets[@]}"; do
+    echo "  $t"
+  done
+  echo "(ZIPs, docs, manifests, checksums, and promoted evidence are never touched by this command.)"
+
+  if [[ $confirmed -eq 0 ]]; then
+    echo
+    echo "Refusing to delete without --confirm. Re-run as: $0 clean --confirm"
+    return 22
+  fi
+
+  for t in "${targets[@]}"; do
+    [[ -n "$t" && "$t" != "/" && "$t" == "$runs_dir"/* ]] || { pack_a_die "internal error: refusing unsafe removal target '$t'"; }
+    rm -rf -- "$t"
+    echo "removed: $t"
+  done
+  rm -f -- "$runs_dir/.last_run" "$runs_dir/.last_reproduce"
+  echo "clean complete."
+  return 0
+}
