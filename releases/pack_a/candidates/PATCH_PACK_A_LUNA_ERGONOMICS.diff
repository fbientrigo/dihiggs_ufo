+#!/usr/bin/env bash
+# `reproduce`: clean extraction -> preflight -> canonical run -> LHE
+# invariant check -> comparison against Sol's reference numbers. Sourced only.
+
+# Sol reference values (PACK_A_SOL_SCIENTIFIC_VALIDATION.md /
+# PACK_A_REPRODUCIBILITY_MATRIX.json), fixed and not re-derived here.
+declare -A PACK_A_REF_SIGMA_PB=( [12345]="0.02349" [67890]="0.02356" )
+declare -A PACK_A_REF_SIGMA_ERR_PB=( [12345]="0.0001364" [67890]="0.0001374" )
+
+pack_a_cmd_reproduce() {
+  pack_a_reject_physics_flags "$@"
+  local seed="12345"
+  while [[ $# -gt 0 ]]; do
+    case "$1" in
+      --seed) seed="$2"; shift 2 ;;
+      *) pack_a_die "unrecognized option '$1' for 'reproduce'" ;;
+    esac
+  done
+  [[ -n "${PACK_A_SEED_CONFIGS[$seed]:-}" ]] || pack_a_die "seed '$seed' is not a Sol-validated point config; only 12345 and 67890 are available"
+  local config="${PACK_A_SEED_CONFIGS[$seed]}"
+
+  local ts repro_dir clean_pack
+  ts="$(pack_a_ts)"
+  repro_dir="$PACK_ROOT/runs/${ts}_reproduce_seed${seed}"
+  clean_pack="$repro_dir/clean_extraction"
+  mkdir -p "$repro_dir"
+
+  pack_a_log "REPRODUCE: materializing a clean extraction at $clean_pack"
+  mkdir -p "$clean_pack"
+  if ! ( cd "$PACK_ROOT" && tar --exclude='./runs' --exclude='./.git' -cf - . ) | ( cd "$clean_pack" && tar -xf - ); then
+    echo 20 > "$repro_dir/exit_status.txt"
+    pack_a_die "clean extraction (tar copy) failed"
+  fi
+
+  PACK_A_PYTHON="$(pack_a_resolve_python)" || exit 20
+  MG5_BIN="$(pack_a_resolve_mg5)" || exit 20
+  export PACK_A_PYTHON MG5_BIN
+
+  pack_a_log "REPRODUCE: preflight on the clean extraction"
+  local preflight_rc=0
+  (
+    PACK_ROOT="$clean_pack"
+    cd "$PACK_ROOT"
+    pack_a_cmd_preflight
+  ) > "$repro_dir/preflight.log" 2>&1 || preflight_rc=$?
+  if [[ $preflight_rc -ne 0 ]]; then
+    pack_a_log "REPRODUCE: preflight failed on clean extraction (exit $preflight_rc); see $repro_dir/preflight.log"
+    echo "$preflight_rc" > "$repro_dir/exit_status.txt"
+    return "$preflight_rc"
+  fi
+
+  local gen_dir="$clean_pack/runs/${ts}_seed${seed}_reproduce"
+  local gen_rc=0
+  pack_a_log "REPRODUCE: canonical generation (seed=$seed) in clean extraction"
+  (
+    PACK_ROOT="$clean_pack"
+    pack_a_do_generate "$gen_dir" "$seed" "$config"
+  ) || gen_rc=$?
+  if [[ $gen_rc -ne 0 ]]; then
+    pack_a_log "REPRODUCE: generation failed (exit $gen_rc); see $gen_dir/run.log"
+    echo "$gen_rc" > "$repro_dir/exit_status.txt"
+    return "$gen_rc"
+  fi
+
+  local lhe
+  lhe="$(find "$gen_dir/events" -maxdepth 1 -type f \( -name '*.lhe.gz' -o -name '*.lhe' \) 2>/dev/null | head -1 || true)"
+  [[ -n "$lhe" ]] || { echo 21 > "$repro_dir/exit_status.txt"; pack_a_log "REPRODUCE: no LHE found after generation"; return 21; }
+
+  local sigma="" err=""
+  sigma="$("$PACK_A_PYTHON" -c "import json; print(json.load(open('$gen_dir/validation/cross_section.json'))['sigma_pb'])" 2>/dev/null || true)"
+  err="$("$PACK_A_PYTHON" -c "import json; print(json.load(open('$gen_dir/validation/cross_section.json'))['integration_error_pb'])" 2>/dev/null || true)"
+
+  pack_a_log "REPRODUCE: checking LHE invariants and cross-section compatibility against Sol reference"
+  local cmp_rc=0
+  "$PACK_A_PYTHON" "$PACK_ROOT/bin/lib/lhe_invariants.py" \
+    --lhe "$lhe" \
+    --expected-mass-gev 200.0 \
+    --sigma-pb "$sigma" \
+    --sigma-error-pb "$err" \
+    --ref-sigma-pb "${PACK_A_REF_SIGMA_PB[$seed]}" \
+    --ref-sigma-error-pb "${PACK_A_REF_SIGMA_ERR_PB[$seed]}" \
+    --output "$repro_dir/comparison.json" || cmp_rc=$?
+
+  echo "$cmp_rc" > "$repro_dir/exit_status.txt"
+  echo "$gen_dir" > "$repro_dir/generation_dir.txt"
+  if [[ $cmp_rc -eq 0 ]]; then
+    pack_a_log "REPRODUCE: PASS (seed=$seed); comparison at $repro_dir/comparison.json"
+  else
+    pack_a_log "REPRODUCE: invariant/cross-section comparison FAILED (seed=$seed); see $repro_dir/comparison.json"
+  fi
+  echo "$repro_dir" > "$PACK_ROOT/runs/.last_reproduce"
+  return "$cmp_rc"
+}
