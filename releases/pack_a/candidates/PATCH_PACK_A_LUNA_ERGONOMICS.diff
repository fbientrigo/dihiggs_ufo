+#!/usr/bin/env bash
+# Python and MadGraph resolution for Pack A. Sourced only.
+#
+# Priority contract (see docs/PACK_A_TROUBLESHOOTING.md):
+#   Python:   1) active `python3` on PATH, if compatible
+#             2) PACK_A_VENV override
+#             3) $HOME/atlas_dihiggs/llp_recast/.venv
+#             4) $HOME/code/dihiggs_llp_recast/.venv
+#   MadGraph: 1) MG5_BIN explicit
+#             2) `command -v mg5_aMC`
+#             3) $MG5_HOME/bin/mg5_aMC
+#             4) $HOME/.local/mg5amcnlo/3.5.3/bin/mg5_aMC
+#
+# Neither function activates anything in the caller's shell; both only
+# print a resolved path on stdout plus a reason/diagnostic on stderr.
+
+pack_a_python_compatible() {
+  local py="$1"
+  [[ -x "$py" ]] || return 1
+  "$py" -c 'import sys; sys.exit(0 if sys.version_info[:2] >= (3, 9) else 1)' >/dev/null 2>&1 || return 1
+  "$py" -c 'import yaml' >/dev/null 2>&1 || return 1
+  return 0
+}
+
+pack_a_python_warn_312() {
+  local py="$1"
+  local ver
+  ver="$("$py" -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null || true)"
+  if [[ "$ver" == "3.12" ]]; then
+    echo "WARN: selected Python is 3.12.x ($py); this MG5 3.5.3 installation marks 3.12 support as experimental (see PACK_A_SOL_SCIENTIFIC_VALIDATION.md). Not a blocker: prior reproductions passed under 3.12." >&2
+  fi
+}
+
+# pack_a_resolve_python - prints the selected python3 path on stdout.
+# Returns 1 and prints an actionable diagnostic on stderr if none qualify.
+pack_a_resolve_python() {
+  local candidate
+
+  candidate="$(command -v python3 2>/dev/null || true)"
+  if [[ -n "$candidate" ]] && pack_a_python_compatible "$candidate"; then
+    echo "selected: active python3 on PATH (${VIRTUAL_ENV:+VIRTUAL_ENV=$VIRTUAL_ENV, }$candidate)" >&2
+    pack_a_python_warn_312 "$candidate"
+    echo "$candidate"
+    return 0
+  fi
+
+  if [[ -n "${PACK_A_VENV:-}" ]]; then
+    candidate="${PACK_A_VENV%/}/bin/python3"
+    if pack_a_python_compatible "$candidate"; then
+      echo "selected: PACK_A_VENV override ($candidate)" >&2
+      pack_a_python_warn_312 "$candidate"
+      echo "$candidate"
+      return 0
+    fi
+    echo "WARN: PACK_A_VENV=$PACK_A_VENV set but $candidate is missing, not executable, too old (<3.9), or lacks PyYAML; falling through" >&2
+  fi
+
+  for fallback in "$HOME/atlas_dihiggs/llp_recast/.venv" "$HOME/code/dihiggs_llp_recast/.venv"; do
+    candidate="${fallback}/bin/python3"
+    if pack_a_python_compatible "$candidate"; then
+      echo "selected: documented fallback venv ($fallback)" >&2
+      pack_a_python_warn_312 "$candidate"
+      echo "$candidate"
+      return 0
+    fi
+  done
+
+  {
+    echo "no compatible Python 3 interpreter with PyYAML found."
+    echo "  tried: active python3 on PATH, PACK_A_VENV, $HOME/atlas_dihiggs/llp_recast/.venv, $HOME/code/dihiggs_llp_recast/.venv"
+    echo "  fix: export PACK_A_VENV=/path/to/venv   (must contain bin/python3 with PyYAML installed)"
+  } >&2
+  return 1
+}
+
+# pack_a_resolve_mg5 - prints the selected mg5_aMC path on stdout.
+pack_a_resolve_mg5() {
+  local candidate
+
+  if [[ -n "${MG5_BIN:-}" ]]; then
+    if [[ -x "$MG5_BIN" ]]; then
+      echo "selected: MG5_BIN override ($MG5_BIN)" >&2
+      echo "$MG5_BIN"
+      return 0
+    fi
+    echo "WARN: MG5_BIN=$MG5_BIN is set but not an executable file; falling through" >&2
+  fi
+
+  candidate="$(command -v mg5_aMC 2>/dev/null || true)"
+  if [[ -n "$candidate" && -x "$candidate" ]]; then
+    echo "selected: mg5_aMC on PATH ($candidate)" >&2
+    echo "$candidate"
+    return 0
+  fi
+
+  if [[ -n "${MG5_HOME:-}" ]]; then
+    candidate="${MG5_HOME%/}/bin/mg5_aMC"
+    if [[ -x "$candidate" ]]; then
+      echo "selected: MG5_HOME/bin/mg5_aMC ($candidate)" >&2
+      echo "$candidate"
+      return 0
+    fi
+  fi
+
+  candidate="$HOME/.local/mg5amcnlo/3.5.3/bin/mg5_aMC"
+  if [[ -x "$candidate" ]]; then
+    echo "selected: documented default install ($candidate)" >&2
+    echo "$candidate"
+    return 0
+  fi
+
+  {
+    echo "no usable MadGraph5_aMC@NLO binary found."
+    echo "  tried: MG5_BIN, mg5_aMC on PATH, \$MG5_HOME/bin/mg5_aMC, $HOME/.local/mg5amcnlo/3.5.3/bin/mg5_aMC"
+    echo "  fix: export MG5_BIN=/path/to/mg5amcnlo/3.5.3/bin/mg5_aMC"
+  } >&2
+  return 1
+}
+
+# pack_a_mg5_version_banner MG5_BIN - prints the startup banner (stdout+stderr
+# merged) so callers can grep for the version line. ~1-2s (model import cost).
+pack_a_mg5_version_banner() {
+  local mg5_bin="$1"
+  printf 'quit\n' | "$mg5_bin" 2>&1 || true
+}
