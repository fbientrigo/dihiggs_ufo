+#!/usr/bin/env bash
+# `results`: locate and summarize evidence for the most recent run.
+# Sourced only. Never call this output "publishable" or "final".
+
+pack_a_cmd_results() {
+  local run_dir
+  run_dir="$(pack_a_find_last_run)"
+  if [[ -z "$run_dir" || ! -d "$run_dir" ]]; then
+    echo "No Pack A runs found under $PACK_ROOT/runs. Run '$0 run' first."
+    return 0
+  fi
+
+  echo "=== PACK_A_LO_SMOKE_XSEC evidence ($run_dir) ==="
+  echo
+  local f
+  for f in \
+    "validation/cross_section.json" \
+    "validation/lhe_report.json" \
+    "manifest.json" \
+    "command.txt" \
+    "environment.json" \
+    "exit_status.txt"
+  do
+    [[ -f "$run_dir/$f" ]] && echo "  $f -> $run_dir/$f"
+  done
+  local lhe
+  lhe="$(find "$run_dir/events" -maxdepth 1 -type f \( -name '*.lhe.gz' -o -name '*.lhe' \) 2>/dev/null | head -1)"
+  [[ -n "$lhe" ]] && echo "  LHE -> $lhe"
+  echo "  run.log -> $run_dir/run.log"
+  echo "  build_point.log -> $run_dir/build_point.log"
+  echo
+  echo "Classification: PACK_A_LO_SMOKE_XSEC (baseline production regression / stable-LLP LHE only)."
+  echo "Not publishable production normalization. See docs/PACK_A_SCIENTIFIC_SCOPE.md for allowed/forbidden uses."
+
+  if [[ -n "${PACK_A_PYTHON:-}" && -f "$run_dir/manifest.json" ]]; then
+    echo
+    echo "--- manifest.json checksums ---"
+    "$PACK_A_PYTHON" -c "
+import json
+d = json.load(open('$run_dir/manifest.json'))
+for k, v in sorted(d.get('files', {}).items()):
+    print(f'  {v}  {k}')
+" || true
+  fi
+  return 0
+}
