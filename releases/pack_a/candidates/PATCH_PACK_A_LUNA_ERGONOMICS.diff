+#!/usr/bin/env bash
+# `run` and the run-generation core shared by `reproduce`. Sourced only.
+
+# Point configs sanctioned by Sol's reproducibility matrix. --seed may only
+# select among these; any other value is rejected. This is not a physics
+# override: both configs describe the identical PI_FIXED point
+# (mphi=200 GeV, g g > H > h2 h2, GC_90 fixed), differing only in the MC
+# seed, exactly as validated in PACK_A_REPRODUCIBILITY_MATRIX.json.
+declare -A PACK_A_SEED_CONFIGS=(
+  [12345]="points/A_PI_NATIVE_200.yaml"
+  [67890]="points/A_PI_NATIVE_200_seed67890.yaml"
+)
+
+pack_a_reject_physics_flags() {
+  local arg
+  local forbidden=(--process --coupling --llp-pdg --mass --decay --pythia --madspin)
+  for arg in "$@"; do
+    for f in "${forbidden[@]}"; do
+      if [[ "$arg" == "$f" || "$arg" == "$f="* ]]; then
+        pack_a_die "physics override flag '$f' is not permitted (Pack A native contract is fixed; see docs/PACK_A_SCIENTIFIC_SCOPE.md)"
+      fi
+    done
+  done
+}
+
+# pack_a_do_generate RUN_DIR SEED CONFIG_PATH - the actual generation core.
+# Writes command.txt, environment.json, preflight.json (if requested by
+# caller before), run.log, exit_status.txt, manifest.json into RUN_DIR.
+# Never overwrites RUN_DIR if it already has an exit_status.txt.
+pack_a_do_generate() {
+  local run_dir="$1" seed="$2" config="$3"
+  mkdir -p "$run_dir/cards" "$run_dir/events" "$run_dir/validation"
+
+  local rc=0
+  {
+    echo "pack_a_python=$PACK_A_PYTHON"
+    echo "mg5_bin=$MG5_BIN"
+    echo "seed=$seed"
+    echo "config=$config"
+    echo "invoked_at_utc=$(pack_a_ts)"
+  } > "$run_dir/command.txt"
+
+  "$PACK_A_PYTHON" - "$MG5_BIN" "$PACK_A_PYTHON" "$run_dir/environment.json" <<'PYEOF' || pack_a_log "WARN: could not write environment.json"
+import json, platform, sys, os
+mg5_bin, py_bin, out = sys.argv[1], sys.argv[2], sys.argv[3]
+data = {
+    "python": {"executable": py_bin, "version": platform.python_version()},
+    "mg5_bin": mg5_bin,
+    "toolchain_expected": "MadGraph5_aMC@NLO 3.5.3",
+    "env_threads": {k: os.environ.get(k) for k in ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "MAKEFLAGS")},
+}
+with open(out, "w") as fh:
+    json.dump(data, fh, indent=2, sort_keys=True)
+    fh.write("\n")
+PYEOF
+
+  local finalize_done=0
+  finalize() {
+    [[ $finalize_done -eq 1 ]] && return
+    finalize_done=1
+    local final_rc=$1
+    echo "$final_rc" > "$run_dir/exit_status.txt"
+    pack_a_log "run finished with exit status $final_rc -> $run_dir/exit_status.txt"
+  }
+
+  pack_a_log "STAGE START: build_point ($config, seed=$seed)"
+  if "$PACK_A_PYTHON" "$PACK_ROOT/scripts/build_point.py" --config "$PACK_ROOT/$config" --output "$run_dir/point" > "$run_dir/build_point.log" 2>&1; then
+    pack_a_log "STAGE OK: build_point"
+  else
+    rc=$?
+    pack_a_log "STAGE FAIL: build_point (exit $rc); see $run_dir/build_point.log"
+    finalize "$rc"
+    return "$rc"
+  fi
+
+  pack_a_log "STAGE START: mg5_smoke"
+  rc=0
+  (
+    export PATH="$(dirname "$PACK_A_PYTHON"):$PATH"
+    export MG5_BIN
+    bash "$PACK_ROOT/scripts/run_mg5_smoke.sh" "$run_dir/point"
+  ) > "$run_dir/run.log" 2>&1 || rc=$?
+  if [[ $rc -eq 0 ]]; then
+    pack_a_log "STAGE OK: mg5_smoke"
+  else
+    pack_a_log "STAGE FAIL: mg5_smoke (exit $rc); see $run_dir/run.log"
+    finalize "$rc"
+    return "$rc"
+  fi
+
+  # Relocate generated artifacts into the run's own tree (never back into
+  # the distributed pack layout) for a stable results/status surface.
+  if [[ -d "$run_dir/point" ]]; then
+    cp -f "$run_dir/point/param_card.dat" "$run_dir/cards/" 2>/dev/null || true
+    cp -f "$run_dir/point/run_card.dat" "$run_dir/cards/" 2>/dev/null || true
+    cp -f "$run_dir/point"/events.lhe* "$run_dir/events/" 2>/dev/null || true
+    cp -f "$run_dir/point/lhe_report.json" "$run_dir/validation/" 2>/dev/null || true
+    cp -f "$run_dir/point/cross_section.json" "$run_dir/validation/" 2>/dev/null || true
+  fi
+
+  "$PACK_A_PYTHON" - "$run_dir" <<'PYEOF' || pack_a_log "WARN: could not write manifest.json"
+import json, hashlib, os, sys
+run_dir = sys.argv[1]
+
+def sha256(path):
+    h = hashlib.sha256()
+    with open(path, "rb") as fh:
+        for chunk in iter(lambda: fh.read(65536), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+manifest = {"run_dir": os.path.basename(run_dir), "files": {}}
+for name in ("build_point.log", "run.log", "command.txt", "environment.json"):
+    p = os.path.join(run_dir, name)
+    if os.path.isfile(p):
+        manifest["files"][name] = sha256(p)
+for sub in ("cards", "events", "validation"):
+    d = os.path.join(run_dir, sub)
+    if os.path.isdir(d):
+        for f in sorted(os.listdir(d)):
+            p = os.path.join(d, f)
+            if os.path.isfile(p):
+                manifest["files"][f"{sub}/{f}"] = sha256(p)
+
+lhe_report_path = os.path.join(run_dir, "validation", "lhe_report.json")
+xsec_path = os.path.join(run_dir, "validation", "cross_section.json")
+if os.path.isfile(lhe_report_path):
+    manifest["lhe_report"] = json.load(open(lhe_report_path))
+if os.path.isfile(xsec_path):
+    manifest["cross_section"] = json.load(open(xsec_path))
+
+with open(os.path.join(run_dir, "manifest.json"), "w") as fh:
+    json.dump(manifest, fh, indent=2, sort_keys=True)
+    fh.write("\n")
+PYEOF
+
+  finalize 0
+  return 0
+}
+
+pack_a_cmd_run() {
+  pack_a_reject_physics_flags "$@"
+  local label="" output_root="$PACK_ROOT/runs" seed="12345"
+  while [[ $# -gt 0 ]]; do
+    case "$1" in
+      --label) label="$2"; shift 2 ;;
+      --output-root) output_root="$2"; shift 2 ;;
+      --seed) seed="$2"; shift 2 ;;
+      *) pack_a_die "unrecognized option '$1' for 'run' (see docs/PACK_A_OPERATOR_COMMANDS.md)" ;;
+    esac
+  done
+  [[ -n "${PACK_A_SEED_CONFIGS[$seed]:-}" ]] || pack_a_die "seed '$seed' is not a Sol-validated point config; only 12345 and 67890 are available"
+  local config="${PACK_A_SEED_CONFIGS[$seed]}"
+  [[ -f "$PACK_ROOT/$config" ]] || pack_a_die "canonical point config $config not found in this pack"
+
+  PACK_A_PYTHON="$(pack_a_resolve_python)" || exit 20
+  MG5_BIN="$(pack_a_resolve_mg5)" || exit 20
+  export PACK_A_PYTHON MG5_BIN
+
+  local ts run_name run_dir
+  ts="$(pack_a_ts)"
+  run_name="${ts}_seed${seed}${label:+_$label}"
+  run_dir="$output_root/$run_name"
+  [[ -e "$run_dir" ]] && pack_a_die "run directory $run_dir already exists (timestamps should not collide; retry)"
+  mkdir -p "$run_dir"
+
+  pack_a_log "RUN: $run_name (config=$config, seed=$seed)"
+  local rc=0
+  pack_a_do_generate "$run_dir" "$seed" "$config" || rc=$?
+  echo "$run_dir" > "$output_root/.last_run"
+  pack_a_log "run directory: $run_dir"
+  return "$rc"
+}
