@@ -22,3 +22,42 @@
   s="${s//$'\n'/\\n}"
   printf '%s' "$s"
 }
+
+# pack_a_atomic_write_pointer POINTER_FILE VALUE - writes VALUE (plus a
+# trailing newline) to POINTER_FILE via a same-directory temp file + rename,
+# so a reader never observes a partially written pointer.
+pack_a_atomic_write_pointer() {
+  local pointer_file="$1" value="$2"
+  local dir tmp
+  dir="$(dirname "$pointer_file")"
+  mkdir -p "$dir"
+  tmp="$(mktemp "$dir/.pointer.XXXXXX")"
+  printf '%s\n' "$value" > "$tmp"
+  mv -f "$tmp" "$pointer_file"
+}
+
+# pack_a_first_lhe RUN_DIR - prints the path to the first *.lhe/*.lhe.gz file
+# directly under RUN_DIR/events, or nothing. Never fails under
+# `set -Eeuo pipefail` even when RUN_DIR/events does not exist.
+pack_a_first_lhe() {
+  local run_dir="$1"
+  local f
+  [[ -d "$run_dir/events" ]] || return 0
+  for f in "$run_dir/events"/*.lhe.gz "$run_dir/events"/*.lhe; do
+    [[ -f "$f" ]] && { printf '%s\n' "$f"; return 0; }
+  done
+  return 0
+}
+
+# pack_a_is_physical_run RUN_DIR - true only if RUN_DIR looks like a genuine
+# operator-visible physical run: has command.txt and at least one LHE file
+# under events/. Used to gate promotion to .last_run and to make
+# status/results fail cleanly instead of running `find` on a directory that
+# may not exist (a reproduce-wrapper directory, a stale pointer target, ...).
+pack_a_is_physical_run() {
+  local run_dir="$1"
+  [[ -n "$run_dir" && -d "$run_dir" ]] || return 1
+  [[ -f "$run_dir/command.txt" ]] || return 1
+  [[ -n "$(pack_a_first_lhe "$run_dir")" ]] || return 1
+  return 0
+}
